# Copy to .env and fill in. Never commit .env.

DISCORD_TOKEN=
OPENAI_API_KEY=

# Right-click server / channel / role / user -> Copy ID (Developer Mode on)
GUILD_ID=
MODLOG_CHANNEL_ID=
MOD_ROLE_ID=

# Comma-separated user IDs of the game bots (Pokétwo, Lawliet).
# Copy them from your own server (right-click the bot -> Copy User ID) rather than trusting a list.
GAME_BOT_IDS=

# Optional: limit cleanup catch-up to these channels. Empty = every readable text channel + active threads
GAME_CHANNEL_IDS=

# Also delete members' messages that mention or reply to a game bot (e.g. "@Pokétwo c pikachu")
CLEANUP_INCLUDE_COMMANDS=false

# Long random string; used to hash reporter IDs for the cooldown table
REPORTER_HMAC_SECRET=

# Global dry-run override, seeded into the database on first start only.
# After that, use /modbot dryrun on|off.
DRY_RUN=true

# OpenAI requests per minute to stay under (check your account's limit)
OPENAI_RPM=300

DB_PATH=modbot.db
RULES_PATH=rules.yaml
LOG_LEVEL=INFO
